{
  "manifest_version": 3,
  "name": "Drops Auto-Claim",
  "version": "3.8",
  "description": "Drops do Rust na Twitch sem esforco: ve o canal certo, resgata cada drop a 100% e passa ao proximo ate ter todos.",
  "background": {
    "service_worker": "fundo.js",
    "type": "module"
  },
  "action": {
    "default_title": "Drops: desligado (clica para ligar)"
  },
  "icons": {
    "128": "icone.png"
  },
  "permissions": [
    "tabs",
    "alarms",
    "storage",
    "cookies",
    "scripting",
    "notifications",
    "contextMenus"
  ],
  "host_permissions": [
    "https://www.twitch.tv/*",
    "https://gql.twitch.tv/*",
    "https://id.twitch.tv/*",
    "https://raw.githubusercontent.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.twitch.tv/*"
      ],
      "js": [
        "espiao.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "homepage_url": "https://tchubirs.github.io/drops/"
}
