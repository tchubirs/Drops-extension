{
  "manifest_version": 3,
  "name": "__MSG_appName__",
  "version": "5.7",
  "description": "__MSG_appDesc__",
  "default_locale": "en",
  "minimum_chrome_version": "102",
  "background": {
    "service_worker": "fundo.js",
    "type": "module"
  },
  "action": {
    "default_title": "__MSG_appName__",
    "default_popup": "painel.html"
  },
  "icons": {
    "128": "icone.png"
  },
  "permissions": [
    "tabs",
    "alarms",
    "storage",
    "cookies",
    "scripting",
    "notifications",
    "contextMenus"
  ],
  "host_permissions": [
    "https://www.twitch.tv/*",
    "https://gql.twitch.tv/*",
    "https://id.twitch.tv/*",
    "https://raw.githubusercontent.com/*"
  ],
  "homepage_url": "https://tchubirs.github.io/drops/"
}
