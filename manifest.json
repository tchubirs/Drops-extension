{
  "manifest_version": 3,
  "name": "__MSG_appName__",
  "version": "5.1",
  "description": "__MSG_appDesc__",
  "default_locale": "en",
  "background": {
    "service_worker": "fundo.js",
    "type": "module"
  },
  "action": {
    "default_title": "__MSG_appName__",
    "default_popup": "painel.html"
  },
  "icons": {
    "128": "icone.png"
  },
  "permissions": [
    "tabs",
    "alarms",
    "storage",
    "cookies",
    "scripting",
    "notifications",
    "contextMenus"
  ],
  "host_permissions": [
    "https://www.twitch.tv/*",
    "https://gql.twitch.tv/*",
    "https://id.twitch.tv/*",
    "https://raw.githubusercontent.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.twitch.tv/*"
      ],
      "js": [
        "cabecalhos-twitch.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "homepage_url": "https://tchubirs.github.io/drops/"
}
